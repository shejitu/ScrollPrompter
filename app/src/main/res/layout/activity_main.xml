<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/prompter_bg">

    <!-- 提示文字显示区 -->
    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/control_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/prompter_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="@dimen/prompter_padding_h"
            android:paddingRight="@dimen/prompter_padding_h"
            android:paddingTop="@dimen/prompter_padding_v"
            android:paddingBottom="@dimen/prompter_padding_v"
            android:textColor="@color/prompter_text"
            android:textSize="42sp"
            android:lineSpacingExtra="14dp"
            android:text="@string/empty_hint"
            android:gravity="top|start" />
    </ScrollView>

    <!-- 设置面板（默认隐藏） -->
    <ScrollView
        android:id="@+id/settings_scroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/control_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/settings_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_panel"
            android:padding="20dp"
            android:visibility="gone">

            <!-- 字体大小 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_font_size"
                    android:textColor="@color/prompter_text"
                    android:textSize="15sp" />
                <TextView
                    android:id="@+id/font_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="42sp"
                    android:textColor="@color/accent"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">
                <SeekBar
                    android:id="@+id/font_seekbar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="66" />
                <EditText
                    android:id="@+id/font_input"
                    android:layout_width="84dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_edit"
                    android:hint="@string/font_input_hint"
                    android:textColorHint="@color/prompter_text_dim"
                    android:textColor="@color/prompter_text"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:maxLength="4"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal" />
            </LinearLayout>

            <!-- 滚动速度 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_scroll_speed"
                    android:textColor="@color/prompter_text"
                    android:textSize="15sp" />
                <TextView
                    android:id="@+id/speed_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text=""
                    android:textColor="@color/accent"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <SeekBar
                android:id="@+id/speed_seekbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="784" />

            <!-- 文字颜色 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/label_text_color"
                android:textColor="@color/prompter_text"
                android:textSize="15sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <FrameLayout
                    android:id="@+id/color_white"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_color_swatch">
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_swatch_fill"
                        android:backgroundTint="@color/prompter_text" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/color_yellow"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_color_swatch">
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_swatch_fill"
                        android:backgroundTint="@color/text_yellow" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/color_green"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_color_swatch">
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_swatch_fill"
                        android:backgroundTint="@color/text_green" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/color_cyan"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_color_swatch">
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_swatch_fill"
                        android:backgroundTint="@color/text_cyan" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/color_orange"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_color_swatch">
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_swatch_fill"
                        android:backgroundTint="@color/text_orange" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/color_pink"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_color_swatch">
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_swatch_fill"
                        android:backgroundTint="@color/text_pink" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 底部控制栏 -->
    <LinearLayout
        android:id="@+id/control_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp"
        android:background="#CC0F1218"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 文稿 -->
        <ImageButton
            android:id="@+id/btn_edit"
            android:layout_width="@dimen/control_size"
            android:layout_height="@dimen/control_size"
            android:background="@drawable/bg_button_round"
            android:src="@drawable/ic_edit"
            android:contentDescription="@string/btn_edit"
            android:scaleType="centerInside"
            android:padding="20dp" />

        <!-- 亮度 -->
        <ImageButton
            android:id="@+id/btn_brightness"
            android:layout_width="@dimen/control_size"
            android:layout_height="@dimen/control_size"
            android:layout_marginStart="@dimen/control_margin"
            android:background="@drawable/bg_button_round"
            android:src="@drawable/ic_brightness"
            android:contentDescription="@string/btn_brightness"
            android:scaleType="centerInside"
            android:padding="20dp" />

        <!-- 语音跟随（你朗读→滚动，停顿→暂停） -->
        <ImageButton
            android:id="@+id/btn_mic"
            android:layout_width="@dimen/control_size"
            android:layout_height="@dimen/control_size"
            android:layout_marginStart="@dimen/control_margin"
            android:background="@drawable/bg_button_round"
            android:src="@drawable/ic_mic"
            android:contentDescription="@string/btn_mic"
            android:scaleType="centerInside"
            android:padding="20dp" />

        <!-- 播放/暂停（大按钮） -->
        <ImageButton
            android:id="@+id/btn_play"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginStart="20dp"
            android:background="@drawable/bg_play_round"
            android:src="@drawable/ic_play"
            android:contentDescription="@string/btn_play"
            android:scaleType="centerInside"
            android:padding="26dp" />

        <!-- 设置 -->
        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="@dimen/control_size"
            android:layout_height="@dimen/control_size"
            android:layout_marginStart="20dp"
            android:background="@drawable/bg_button_round"
            android:src="@drawable/ic_settings"
            android:contentDescription="@string/btn_settings"
            android:scaleType="centerInside"
            android:padding="20dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
